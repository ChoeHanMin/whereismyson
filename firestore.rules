rules_version = '2';

// Firebase 콘솔 → Firestore Database → 규칙 탭에 붙여넣고 "게시"하세요.
// UID는 Authentication → 사용자 목록의 "사용자 UID" 값이에요. (아들, 어머니, 아버지 순)
service cloud.firestore {
  match /databases/{database}/documents {
    function isSon() {
      return request.auth != null && request.auth.uid == 'W7n5MUK712X9fBJxdnZYPTSU8mF2';
    }
    function isFamily() {
      return request.auth != null
        && request.auth.uid in ['W7n5MUK712X9fBJxdnZYPTSU8mF2', 'pvVkZjnDijZQKLF26nSBteJi0dB3', 'zkPfkzdhqPPNUStWnbLyEQqu8r73'];
    }

    match /status/{doc} {
      allow read: if isFamily();
      allow write: if isSon();
    }
    match /events/{id} {
      allow read: if isFamily();
      allow create: if isSon();
    }
    // 아들의 카카오 연결 정보: 아들만
    match /private/{doc} {
      allow read, write: if isSon();
    }
  }
}
