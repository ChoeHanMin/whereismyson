rules_version = '2';

// Firebase 콘솔 → Firestore Database → 규칙 탭에 붙여넣고 "게시"하세요.
// UID는 Authentication → 사용자 목록의 "사용자 UID" 값이에요. (아들, 어머니, 아버지 순)
service cloud.firestore {
  match /databases/{database}/documents {
    function isSon() {
      return request.auth != null && request.auth.uid == 'RP50dVDWDvVmaBqcIwcdXqn7GVm2';
    }
    function isFamily() {
      return request.auth != null
        && request.auth.uid in ['RP50dVDWDvVmaBqcIwcdXqn7GVm2', 'ttEzIkPWmTTtobXo3jinq8trhJF2', 'F0QmRpf02Efr6hs4N3o1MCb2aws2'];
    }

    match /status/{doc} {
      allow read: if isFamily();
      allow write: if isSon();
    }
    match /events/{id} {
      allow read: if isFamily();
      allow create: if isSon();
    }
  }
}
